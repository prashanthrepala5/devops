# Supabase project settings (use the Project URL and publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional for the separate authenticated automation API. Never expose secrets
# by prefixing them with NEXT_PUBLIC_.
# REACHOPS_API_BASE_URL=https://your-authenticated-automation-api.example.com
